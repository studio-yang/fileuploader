# ============================================================================
# FileFlow 環境變數設定
# ============================================================================
# 部署到 Vercel 時，將以下變數填入 Vercel 的 Environment Variables 設定
# ============================================================================

# ─── Google Drive（必填，主要儲存）──────────────────────────────────────────
# Service Account JSON Key（Base64 編碼）
# 取得方式：GCP Console → IAM → Service Accounts → 建立金鑰 → 下載 JSON → Base64 編碼
GDRIVE_SERVICE_ACCOUNT_KEY=your-base64-encoded-service-account-json

# 目標 Google Drive 資料夾 ID
# 取得方式：到 Google Drive 建立資料夾 → 複製網址中 /folders/ 後面那串
GOOGLE_DRIVE_FOLDER_ID=your-folder-id

# ─── GitHub Releases（必填，備用儲存）─────────────────────────────────────────
# GitHub Personal Access Token
# 取得方式：GitHub → Settings → Developer settings → Personal access tokens
#   → Fine-grained tokens → 授予 Contents: Read and write 權限
GITHUB_TOKEN=ghp_your-personal-access-token
GITHUB_OWNER=your-github-username
GITHUB_REPO=your-repo-name

# ─── App 設定（必填）──────────────────────────────────────────────────────────
# 允許的 CORS 來源（部署後填入你的 Vercel 網址）
ALLOWED_ORIGINS=https://your-domain.vercel.app

# 單檔最大上傳大小（位元組，預設 5 GB）
MAX_FILE_SIZE=5368709120

# ============================================================================
# 以下變數「可選」— 目前停用 GCS 與 OAuth Drive，留空即可
# 未來如果要啟用 GCS，再到 ProviderSelector.tsx 把 ENABLED.gcs 改為 true
# ============================================================================

# ─── Google Cloud Storage（可選，目前停用）────────────────────────────────────
# GCS_PROJECT_ID=
# GCS_BUCKET_NAME=
# GCS_SERVICE_ACCOUNT_KEY=

# ─── Google Drive OAuth（可選，舊版小檔案後端串流用，目前停用）─────────────
# GOOGLE_DRIVE_CLIENT_ID=
# GOOGLE_DRIVE_CLIENT_SECRET=
# GOOGLE_DRIVE_REFRESH_TOKEN=
